<Ui xmlns="http://www.blizzard.com/wow/ui/">
	<!-- World-map pin for Hawary's Discovery layer. The mixin is created at login in
	     Discovery.lua (Blizzard_MapCanvas is load-on-demand); it's looked up when a pin is made. -->
	<Frame name="HawarysDiscoveryPinTemplate" mixin="HawarysDiscoveryPinMixin" enableMouse="true" virtual="true">
		<Size x="14" y="14"/>
		<Layers>
			<Layer level="BACKGROUND">
				<Texture parentKey="Glow" file="Interface\AddOns\HawarysAddon\Media\glow">
					<Size x="30" y="30"/>
					<Anchors>
						<Anchor point="CENTER"/>
					</Anchors>
				</Texture>
			</Layer>
			<Layer level="ARTWORK">
				<Texture parentKey="Icon" setAllPoints="true"/>
			</Layer>
		</Layers>
		<Scripts>
			<OnLoad method="OnLoad"/>
		</Scripts>
	</Frame>
	<Frame name="HawarysQuestPinTemplate" mixin="HawarysQuestPinMixin" enableMouse="true" virtual="true">
		<Size x="14" y="14"/>
		<Layers>
			<Layer level="BACKGROUND">
				<Texture parentKey="Glow" file="Interface\AddOns\HawarysAddon\Media\glow">
					<Size x="30" y="30"/>
					<Anchors>
						<Anchor point="CENTER"/>
					</Anchors>
				</Texture>
			</Layer>
			<Layer level="ARTWORK">
				<Texture parentKey="Icon" setAllPoints="true"/>
			</Layer>
		</Layers>
		<Scripts>
			<OnLoad method="OnLoad"/>
		</Scripts>
	</Frame>
</Ui>
